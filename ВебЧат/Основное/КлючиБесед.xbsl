//Ключ виджета: «собеседник.беседа.срок.подпись», HMAC-SHA256. Выданные ключи не хранятся:
//подпись говорит, кто это, а участие в беседе проверяется заново на каждый запрос,
//поэтому исключение из беседы и отключение собеседника гасят ключ сразу
конст СРОК_КЛЮЧА_СЕКУНД = 1800

@ВПроекте
метод ВыдатьКлюч(Собеседник: Собеседники.Ссылка, Беседа: Беседы.Ссылка): Строка
    если не Допущен(Собеседник, Беседа)
        возврат ""
    ;
    знч Срок = Момент.Сейчас().ПолучитьОтметкуВремениUnix() + СРОК_КЛЮЧА_СЕКУНД
    знч Данные = "%{Собеседник.Ид.ВСтроку()}.%{Беседа.Ид.ВСтроку()}.%{Срок.ВСтроку()}"
    возврат "%{Данные}.%{Подпись(Данные)}"
;

//Собеседник по ключу, если ключ годен для этой беседы; иначе Неопределено
@ВПроекте
метод СобеседникПоКлючу(Ключ: Строка, Беседа: Беседы.Ссылка): Собеседники.Ссылка?
    знч Части = Ключ.Разделить(".")
    если Части.Размер() != 4
        или Подпись("%{Части[0]}.%{Части[1]}.%{Части[2]}") != Части[3]
        или Части[1] != Беседа.Ид.ВСтроку()
        возврат Неопределено
    ;
    попытка
        если новый Число(Части[2]) < Момент.Сейчас().ПолучитьОтметкуВремениUnix()
            возврат Неопределено
        ;
        знч Собеседник = УчастникБеседы(Беседа, Части[0])
        возврат Собеседник != Неопределено и Допущен(Собеседник!, Беседа) ? Собеседник : Неопределено
    поймать Исключение: Исключение
        возврат Неопределено
    ;
;

//Почему ключ не принят — для тела ответа 401: виджет показывает «Доступ к чату закрыт»,
//а причину видно в инструментах разработчика и в тесте
@ВПроекте
метод ПричинаОтказа(Ключ: Строка, Беседа: Беседы.Ссылка): Строка
    знч Части = Ключ.Разделить(".")
    если Части.Размер() != 4 или Подпись("%{Части[0]}.%{Части[1]}.%{Части[2]}") != Части[3]
        возврат "подпись"
    ;
    если Части[1] != Беседа.Ид.ВСтроку()
        возврат "другая беседа"
    ;
    попытка
        если новый Число(Части[2]) < Момент.Сейчас().ПолучитьОтметкуВремениUnix()
            возврат "срок"
        ;
        возврат УчастникБеседы(Беседа, Части[0]) == Неопределено ? "не участник беседы" : "участник отключён"
    поймать Исключение: Исключение
        возврат "подпись"
    ;
;

//Участник беседы в любом состоянии и не отключён: состояние решает, что ему можно (ПерепискаВебЧата)
@ВПроекте
метод Допущен(Собеседник: Собеседники.Ссылка, Беседа: Беседы.Ссылка): Булево
    исп КонтекстДоступа.Привилегированный()
    исп Записи = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1
        УчастникиБесед.Состояние КАК Состояние
    ИЗ
        УчастникиБесед КАК УчастникиБесед
    ГДЕ
        УчастникиБесед.Беседа == %Беседа
        И УчастникиБесед.Собеседник == %Собеседник
        И НЕ УчастникиБесед.Собеседник.Отключен}.Выполнить()
    возврат не Записи.Пусто()
;

@Локально
метод Подпись(Данные: Строка): Строка
    знч Вычислитель = новый ВычислительHmac(Секрет().ВБайты(), АлгоритмХеширования.Sha256)
    Вычислитель.ДобавитьДанные(Данные.ВБайты())
    возврат Вычислитель.ПолучитьРезультат().ВСтроку()
;

//Секрет создаётся при первой выдаче ключа; его смена гасит все выданные ключи
@Локально
метод Секрет(): Строка
    исп КонтекстДоступа.Привилегированный()
    знч Запись = новый ПараметрыВебЧата.КлючЗаписи().ЗагрузитьЗапись() ?? новый ПараметрыВебЧата.Запись()
    если Запись.СекретКлючей != ""
        возврат Запись.СекретКлючей
    ;
    Запись.СекретКлючей = новый Ууид().ВСтроку() + новый Ууид().ВСтроку()
    ПараметрыВебЧата.Записать(Запись)
    возврат Запись.СекретКлючей
;

//Собеседник по идентификатору из ключа, если он участник беседы; посторонний — Неопределено
@ВПроекте
метод УчастникБеседы(Беседа: Беседы.Ссылка, ИдСобеседника: Строка): Собеседники.Ссылка?
    исп КонтекстДоступа.Привилегированный()
    знч Собеседник = новый Собеседники.Ссылка(новый Ууид(ИдСобеседника))
    знч Запись = новый УчастникиБесед.КлючЗаписи(Беседа = Беседа, Собеседник = Собеседник).ЗагрузитьЗапись()
    возврат Запись == Неопределено ? Неопределено : Собеседник
;
