метод ОсновнаяТаблицаПриНажатииСтроки(Источник: Список<ДинамическийСписок<ПрисутствиеСобеседниковСписокАдминистратора.ДанныеСтрокиСписка>>,
    Событие: СобытиеСДанными<СтрокаСписка<СтрокаДинамическогоСписка<ПрисутствиеСобеседниковСписокАдминистратора.ДанныеСтрокиСписка>>>)
    ПрисутствиеСобеседников.АвтоматическаяФормаЗаписи.Открыть(
        КлючЗаписи = КлючСтроки(Событие.Данные.ДанныеСтроки.Данные))
;

@Локально
метод КлючСтроки(Данные: ПрисутствиеСобеседниковСписокАдминистратора.ДанныеСтрокиСписка): ПрисутствиеСобеседников.КлючЗаписи
    возврат новый ПрисутствиеСобеседников.КлючЗаписи(Собеседник = Данные.Собеседник!)
;

@НаКлиенте
метод УдалитьЗапись(Команда: КомандаСПараметром<СтрокаДинамическогоСписка<ПрисутствиеСобеседниковСписокАдминистратора.ДанныеСтрокиСписка>>,
    Параметр: СтрокаДинамическогоСписка<ПрисутствиеСобеседниковСписокАдминистратора.ДанныеСтрокиСписка>)
    знч Ответ = Диалог.Вопрос(
        "Удалить запись?",
        [СтандартнаяКнопкаДиалога.Да, СтандартнаяКнопкаДиалога.Отмена],
        "Запись регистра ПрисутствиеСобеседников будет удалена без возможности восстановления."
    )
    если Ответ != СтандартнаяКнопкаДиалога.Да
        возврат
    ;
    УдалитьЗаписьНаСервере(Параметр.Данные.Собеседник)
    Компоненты.ОсновнаяТаблица.Обновить()
;

@Контекстный
@НаСервере @ДоступноСКлиента
метод УдалитьЗаписьНаСервере(Собеседник: Собеседники.Ссылка?)
    ПрисутствиеСобеседников.Удалить(новый ПрисутствиеСобеседников.КлючЗаписи(Собеседник = Собеседник!))
;
