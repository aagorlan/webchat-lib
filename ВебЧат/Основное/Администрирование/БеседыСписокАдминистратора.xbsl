метод ОсновнаяТаблицаПриНажатииСтроки(Источник: Список<ДинамическийСписок<БеседыСписокАдминистратора.ДанныеСтрокиСписка>>,
    Событие: СобытиеСДанными<СтрокаСписка<СтрокаДинамическогоСписка<БеседыСписокАдминистратора.ДанныеСтрокиСписка>>>)
    Беседы.АвтоматическаяФормаОбъекта.Открыть(
        КлючОбъекта = Событие.Данные.ДанныеСтроки.Данные.Ссылка)
;

@НаКлиенте
метод ПометитьНаУдаление(Команда: КомандаСПараметром<СтрокаДинамическогоСписка<БеседыСписокАдминистратора.ДанныеСтрокиСписка>>,
    Параметр: СтрокаДинамическогоСписка<БеседыСписокАдминистратора.ДанныеСтрокиСписка>)
    ПометитьНаУдалениеНаСервере(Параметр.Данные.Ссылка)
    Компоненты.ОсновнаяТаблица.Обновить()
;

@Контекстный
@НаСервере @ДоступноСКлиента
метод ПометитьНаУдалениеНаСервере(Ссылка: Беседы.Ссылка)
    Беседы.УстановитьПометкуУдаления(Ссылка, Истина)
;

@НаКлиенте
метод УдалитьНавсегда(Команда: КомандаСПараметром<СтрокаДинамическогоСписка<БеседыСписокАдминистратора.ДанныеСтрокиСписка>>,
    Параметр: СтрокаДинамическогоСписка<БеседыСписокАдминистратора.ДанныеСтрокиСписка>)
    знч Ответ = Диалог.Вопрос(
        "Удалить безвозвратно?",
        [СтандартнаяКнопкаДиалога.Да, СтандартнаяКнопкаДиалога.Отмена],
        "Запись Беседы будет удалена без возможности восстановления."
    )
    если Ответ != СтандартнаяКнопкаДиалога.Да
        возврат
    ;
    УдалитьНавсегдаНаСервере(Параметр.Данные.Ссылка)
    Компоненты.ОсновнаяТаблица.Обновить()
;

@Контекстный
@НаСервере @ДоступноСКлиента
метод УдалитьНавсегдаНаСервере(Ссылка: Беседы.Ссылка)
    знч Объект = Ссылка.ЗагрузитьОбъект()
    Объект.Удалить()
;
