метод ОсновнаяТаблицаПриНажатииСтроки(Источник: Список<ДинамическийСписок<СобеседникиСписокАдминистратора.ДанныеСтрокиСписка>>,
    Событие: СобытиеСДанными<СтрокаСписка<СтрокаДинамическогоСписка<СобеседникиСписокАдминистратора.ДанныеСтрокиСписка>>>)
    Собеседники.АвтоматическаяФормаОбъекта.Открыть(
        КлючОбъекта = Событие.Данные.ДанныеСтроки.Данные.Ссылка)
;

@НаКлиенте
метод ПометитьНаУдаление(Команда: КомандаСПараметром<СтрокаДинамическогоСписка<СобеседникиСписокАдминистратора.ДанныеСтрокиСписка>>,
    Параметр: СтрокаДинамическогоСписка<СобеседникиСписокАдминистратора.ДанныеСтрокиСписка>)
    ПометитьНаУдалениеНаСервере(Параметр.Данные.Ссылка)
    Компоненты.ОсновнаяТаблица.Обновить()
;

@Контекстный
@НаСервере @ДоступноСКлиента
метод ПометитьНаУдалениеНаСервере(Ссылка: Собеседники.Ссылка)
    Собеседники.УстановитьПометкуУдаления(Ссылка, Истина)
;

@НаКлиенте
метод УдалитьНавсегда(Команда: КомандаСПараметром<СтрокаДинамическогоСписка<СобеседникиСписокАдминистратора.ДанныеСтрокиСписка>>,
    Параметр: СтрокаДинамическогоСписка<СобеседникиСписокАдминистратора.ДанныеСтрокиСписка>)
    знч Ответ = Диалог.Вопрос(
        "Удалить безвозвратно?",
        [СтандартнаяКнопкаДиалога.Да, СтандартнаяКнопкаДиалога.Отмена],
        "Запись Собеседники будет удалена без возможности восстановления."
    )
    если Ответ != СтандартнаяКнопкаДиалога.Да
        возврат
    ;
    УдалитьНавсегдаНаСервере(Параметр.Данные.Ссылка)
    Компоненты.ОсновнаяТаблица.Обновить()
;

@Контекстный
@НаСервере @ДоступноСКлиента
метод УдалитьНавсегдаНаСервере(Ссылка: Собеседники.Ссылка)
    знч Объект = Ссылка.ЗагрузитьОбъект()
    Объект.Удалить()
;
