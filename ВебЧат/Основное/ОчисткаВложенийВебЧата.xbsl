//Файл, загруженный в виджете, ждёт отправки сообщения в ВложенияВебЧата. Не отправили
//за сутки — запись удаляется, файл помечается неиспользуемым
@Обработчик
метод Обработчик()
    исп КонтекстДоступа.Привилегированный()
    исп Брошенные = Запрос{ВЫБРАТЬ
        ВложенияВебЧата.Ид КАК Ид,
        ВложенияВебЧата.Файл КАК Файл,
        ВложенияВебЧата.Превью КАК Превью
    ИЗ
        ВложенияВебЧата КАК ВложенияВебЧата
    ГДЕ
        ВложенияВебЧата.Загружено.ДобавитьДни(1) < %{ДатаВремя.Сейчас()}}.Выполнить()
    знч Файлы = <ДвоичныйОбъект.Ссылка>[]
    для Брошенное из Брошенные
        если Брошенное.Файл != Неопределено
            Файлы.Добавить(Брошенное.Файл!)
        ;
        если Брошенное.Превью != Неопределено
            Файлы.Добавить(Брошенное.Превью!)
        ;
        ВложенияВебЧата.Удалить(новый ВложенияВебЧата.КлючЗаписи(Ид = Брошенное.Ид))
    ;
    если не Файлы.Пусто()
        ОбъектноеХранилище.УстановитьНеиспользуемые(Файлы)
    ;
;
