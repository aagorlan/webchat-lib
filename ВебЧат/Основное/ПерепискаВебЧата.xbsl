    пер Измененные: Массив<ДанныеСообщения>
    пер Удаленные: Массив<Строка>
;

@ВПроекте
структура ЧерновикСообщения
    пер Текст: Строка
    пер ТекстБезРазметки: Строка
    пер Ответ: Строка
    пер Вложения: Массив<Строка>
    //Номера файлов, которые остаются у изменяемого сообщения; не передано — остаются все
    пер Оставить: Массив<Число>?
;

@ВПроекте
структура ВыборРеакции
    пер Реакция: Строка
;

@ВПроекте
структура ЗагруженноеВложение
    пер Ид: Строка
    пер Имя: Строка
    пер ЭтоИзображение: Булево
;

//Без номера — последние сообщения и отметка прочтения: открыл чат — прочитал
@ВПроекте
метод ПолучитьПорцию(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка, ДоНомера: Число): Порция
    исп КонтекстДоступа.Привилегированный()
    знч Сообщения = ДанныеСообщений(Беседа, Собеседник, Запрос{ВЫБРАТЬ ПЕРВЫЕ 20
            СообщенияБесед.Ссылка КАК Ссылка
        ИЗ
            СообщенияБесед КАК СообщенияБесед
        ГДЕ
            СообщенияБесед.Беседа == %Беседа
            И НЕ СообщенияБесед.ПометкаУдаления
            И НЕ СообщенияБесед.Автор.Отключен.ЗаменитьNull(Ложь)
            И (%ДоНомера == 0 ИЛИ СообщенияБесед.Номер < %ДоНомера)
        УПОРЯДОЧИТЬ ПО
            СообщенияБесед.Номер УБЫВ}.Выполнить().Преобразовать(Стр -> Стр.Ссылка))

    знч Первый = Сообщения.Пусто() ? 0 : Сообщения.Первый().Номер
    пер ПервоеНепрочитанное = 0
    если ДоНомера == 0
        знч Прочтение = новый ПрочтениеБесед.КлючЗаписи(Беседа = Беседа, Собеседник = Собеседник).ЗагрузитьЗапись()
        знч Прочитано = Прочтение == Неопределено ? 0 : Прочтение.ПоследнийПрочитанный
        для Сообщение из Сообщения
            если Сообщение.Номер > Прочитано и не Сообщение.Свое
                ПервоеНепрочитанное = Сообщение.Номер
                прервать
            ;
        ;
        ВебЧат.ОтметитьПрочитанной(Беседа, Собеседник)
    ;
    возврат новый Порция(
        Сообщения = Сообщения,
        ЕстьРаньше = Первый > 0 и ЕстьСообщенияДо(Беседа, Первый),
        ПервоеНепрочитанное = ПервоеНепрочитанное,
        МожноПисать = МожноПисать(Беседа, Собеседник),
        Я = Собеседник.Ид.ВСтроку())
;

//Сверка загруженного с сервером: новые после последнего номера, пропавшие и изменённые
//(метка версии меняется при правке и при реакции). Ничего не изменилось — пустой ответ
@ВПроекте
метод ПолучитьИзменения(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка, ЧтоЕсть: ЗапросИзменений): Изменения
    исп КонтекстДоступа.Привилегированный()

    знч Известные = <СообщенияБесед.Ссылка>[]
    знч ВерсииИзвестных = <СообщенияБесед.Ссылка, Строка>{:}
    для Известное из ЧтоЕсть.Известные
        попытка
            знч Ссылка = новый СообщенияБесед.Ссылка(новый Ууид(Известное.Ид))
            Известные.Добавить(Ссылка)
            ВерсииИзвестных.Вставить(Ссылка, Известное.Версия)
        поймать Исключение: Исключение
            //чужой или испорченный идентификатор просто не сверяется
        ;
    ;

    знч Новые = ДанныеСообщений(Беседа, Собеседник, Запрос{ВЫБРАТЬ
            СообщенияБесед.Ссылка КАК Ссылка
        ИЗ
            СообщенияБесед КАК СообщенияБесед
        ГДЕ
            СообщенияБесед.Беседа == %Беседа
            И СообщенияБесед.Номер > %{ЧтоЕсть.Последний}
            И НЕ СообщенияБесед.ПометкаУдаления
            И НЕ СообщенияБесед.Автор.Отключен.ЗаменитьNull(Ложь)}.Выполнить().Преобразовать(Стр -> Стр.Ссылка))

    знч Удаленные = <Строка>[]
    знч Измененные = <СообщенияБесед.Ссылка>[]
    если не Известные.Пусто()
        знч Текущие = <СообщенияБесед.Ссылка, Строка>{:}
        исп Результат = Запрос{ВЫБРАТЬ
            СообщенияБесед.Ссылка КАК Ссылка,
            СообщенияБесед.МеткаВерсии КАК МеткаВерсии
        ИЗ
            СообщенияБесед КАК СообщенияБесед
        ГДЕ
            СообщенияБесед.Ссылка В (%Известные)
            И СообщенияБесед.Беседа == %Беседа
            И НЕ СообщенияБесед.ПометкаУдаления
            И НЕ СообщенияБесед.Автор.Отключен.ЗаменитьNull(Ложь)}.Выполнить()
        для Текущее из Результат
            Текущие.Вставить(Текущее.Ссылка, Текущее.МеткаВерсии.ВСтроку())
        ;
        для Ссылка из Известные
            если не Текущие.СодержитКлюч(Ссылка)
                Удаленные.Добавить(Ссылка.Ид.ВСтроку())
            иначе если Текущие.Получить(Ссылка) != ВерсииИзвестных.Получить(Ссылка)
                Измененные.Добавить(Ссылка)
            ;
        ;
    ;

    если не Новые.Пусто()
        ВебЧат.ОтметитьПрочитанной(Беседа, Собеседник)
    ;
    возврат новый Изменения(
        Новые = Новые,
        Измененные = Измененные.Пусто() ? <ДанныеСообщения>[] : ДанныеСообщений(Беседа, Собеседник, Измененные),
        Удаленные = Удаленные)
;

@ВПроекте
метод Отправить(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка, Черновик: ЧерновикСообщения): ДанныеСообщения?
    если не МожноПисать(Беседа, Собеседник)
        возврат Неопределено
    ;
    исп КонтекстДоступа.Привилегированный()

    знч Сообщение = новый СообщенияБесед.Объект()
    Сообщение.Беседа = Беседа
    Сообщение.Автор = Собеседник
    Сообщение.Дата = ДатаВремя.Сейчас()
    Сообщение.Текст = ОчиститьРазметку(Черновик.Текст)
    Сообщение.ТекстКратко = Кратко(Черновик.ТекстБезРазметки)
    Сообщение.Ответ = СообщениеЭтойБеседы(Черновик.Ответ, Беседа)
    ДобавитьВложения(Сообщение, Беседа, Собеседник, Черновик.Вложения)
    Сообщение.Записать()
    ВебЧат.ОтметитьПрочитанной(Беседа, Собеседник)
    возврат ДанныеСообщений(Беседа, Собеседник, [Сообщение.Ссылка]).Первый()
;

@ВПроекте
метод Изменить(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка, ИдСообщения: Строка,
    Черновик: ЧерновикСообщения): ДанныеСообщения?

    знч Ссылка = СвоеСообщение(ИдСообщения, Беседа, Собеседник)
    если Ссылка == Неопределено или не МожноПисать(Беседа, Собеседник)
        возврат Неопределено
    ;
    исп КонтекстДоступа.Привилегированный()
    знч Сообщение = Ссылка!.ЗагрузитьОбъект()
    Сообщение.Текст = ОчиститьРазметку(Черновик.Текст)
    Сообщение.ТекстКратко = Кратко(Черновик.ТекстБезРазметки)

    знч Освободить = <ДвоичныйОбъект.Ссылка>[]
    если Черновик.Оставить != Неопределено
        знч Убрать = <СообщенияБесед.Файлы>[]
        пер Номер = 0
        для СтрокаФайла из Сообщение.Файлы
            если не Черновик.Оставить!.Содержит(Номер)
                Убрать.Добавить(СтрокаФайла)
                если СтрокаФайла.Файл != Неопределено
                    Освободить.Добавить(СтрокаФайла.Файл!)
                ;
                если СтрокаФайла.Превью != Неопределено
                    Освободить.Добавить(СтрокаФайла.Превью!)
                ;
            ;
            Номер += 1
        ;
        для СтрокаФайла из Убрать
            Сообщение.Файлы.Удалить(СтрокаФайла)
        ;
    ;
    ДобавитьВложения(Сообщение, Беседа, Собеседник, Черновик.Вложения)
    Сообщение.Записать()
    если не Освободить.Пусто()
        ОбъектноеХранилище.УстановитьНеиспользуемые(Освободить)
    ;
    возврат ДанныеСообщений(Беседа, Собеседник, [Ссылка!]).Первый()
;

//Вложение берётся, только если его загрузил этот же собеседник в эту же беседу
@Локально
метод ДобавитьВложения(Сообщение: СообщенияБесед.Объект, Беседа: Беседы.Ссылка,
    Собеседник: Собеседники.Ссылка, Вложения: ЧитаемыйМассив<Строка>)

    для ИдВложения из Вложения
        попытка
            знч Ключ = новый ВложенияВебЧата.КлючЗаписи(Ид = новый Ууид(ИдВложения))
            знч Вложение = Ключ.ЗагрузитьЗапись()
            если Вложение == Неопределено или Вложение.Собеседник != Собеседник или Вложение.Беседа != Беседа
                продолжить
            ;
            знч СтрокаФайла = новый СообщенияБесед.Файлы()
            СтрокаФайла.Файл = Вложение.Файл
            СтрокаФайла.Превью = Вложение.Превью
            СтрокаФайла.ИмяФайла = Вложение.ИмяФайла
            СтрокаФайла.ЭтоИзображение = Вложение.ЭтоИзображение
            Сообщение.Файлы.Добавить(СтрокаФайла)
            ВложенияВебЧата.Удалить(Ключ)
        поймать Исключение: Исключение
            //испорченный идентификатор вложения пропускается
        ;
    ;
;

//Своё сообщение пропадает из ленты, у ответов на него цитата — «Сообщение удалено». Чужое
//удаляет только администратор беседы: оно остаётся в ленте пометкой «Удалено администратором»
@ВПроекте
метод Удалить(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка, ИдСообщения: Строка): Булево
    знч Ссылка = СообщениеЭтойБеседы(ИдСообщения, Беседа)
    если Ссылка == Неопределено
        возврат Ложь
    ;
    исп КонтекстДоступа.Привилегированный()
    знч Сообщение = Ссылка!.ЗагрузитьОбъект()
    если Сообщение.Служебное или Сообщение.УдаленоАдминистратором
        возврат Ложь
    ;
    если Сообщение.Автор == Собеседник
        если не МожноПисать(Беседа, Собеседник)
            возврат Ложь
        ;
        исп Ответы = Запрос{ВЫБРАТЬ
            СообщенияБесед.Ссылка КАК Ссылка
        ИЗ
            СообщенияБесед КАК СообщенияБесед
        ГДЕ
            СообщенияБесед.Ответ == %Ссылка}.Выполнить()
        для СтрокаОтвета из Ответы
            знч Ответ = СтрокаОтвета.Ссылка.ЗагрузитьОбъект()
            Ответ.Ответ = Неопределено
            Ответ.ОтветУдален = Истина
            Ответ.Записать()
        ;
        //Запись не удаляется, а очищается и помечается: автонумерация отдала бы номер удалённого
        //документа новому сообщению, и оно встало бы ниже прочитанного и мимо сверки.
        //Помеченное нигде не показывается, номер остаётся занятым навсегда
        знч Файлы = ОчиститьСообщение(Сообщение)
        Сообщение.Записать()
        СообщенияБесед.УстановитьПометкуУдаления(Ссылка!, Истина)
        если не Файлы.Пусто()
            ОбъектноеХранилище.УстановитьНеиспользуемые(Файлы)
        ;
        возврат Истина
    ;
    если ВебЧат.Состояние(Беседа, Собеседник) != СостоянияУчастникаБеседы.Администратор
        возврат Ложь
    ;
    знч Файлы = ОчиститьСообщение(Сообщение)
    Сообщение.УдаленоАдминистратором = Истина
    Сообщение.Записать()
    если не Файлы.Пусто()
        ОбъектноеХранилище.УстановитьНеиспользуемые(Файлы)
    ;
    возврат Истина
;

//Текст, цитата, файлы и реакции сообщения убираются; возвращаются файлы, которые больше не нужны
@Локально
метод ОчиститьСообщение(Сообщение: СообщенияБесед.Объект): Массив<ДвоичныйОбъект.Ссылка>
    знч Файлы = <ДвоичныйОбъект.Ссылка>[]
    для Файл из Сообщение.Файлы
        если Файл.Файл != Неопределено
            Файлы.Добавить(Файл.Файл!)
        ;
        если Файл.Превью != Неопределено
            Файлы.Добавить(Файл.Превью!)
        ;
    ;
    Сообщение.Текст = ""
    Сообщение.ТекстКратко = ""
    Сообщение.Ответ = Неопределено
    Сообщение.Файлы.Очистить()
    Сообщение.Реакции.Очистить()
    возврат Файлы
;

//Повторный выбор той же реакции снимает её, другой — заменяет
@ВПроекте
метод ПереключитьРеакцию(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка, ИдСообщения: Строка,
    Реакция: Строка): ДанныеСообщения?

    если не КодыРеакций().Содержит(Реакция)
        или ВебЧат.Состояние(Беседа, Собеседник) != СостоянияУчастникаБеседы.МожетПисать
        возврат Неопределено
    ;
    знч Ссылка = СообщениеЭтойБеседы(ИдСообщения, Беседа)
    если Ссылка == Неопределено
        возврат Неопределено
    ;
    исп КонтекстДоступа.Привилегированный()
    знч Сообщение = Ссылка!.ЗагрузитьОбъект()
    если Сообщение.Служебное или Сообщение.УдаленоАдминистратором
        возврат Неопределено
    ;
    знч Своя = Сообщение.Реакции.Фильтровать(Стр -> Стр.Собеседник == Собеседник).ЕдинственныйИлиНеопределено()
    если Своя == Неопределено
        знч СтрокаРеакции = новый СообщенияБесед.Реакции()
        СтрокаРеакции.Реакция = Реакция
        СтрокаРеакции.Собеседник = Собеседник
        Сообщение.Реакции.Добавить(СтрокаРеакции)
    иначе если Своя.Реакция == Реакция
        Сообщение.Реакции.Удалить(Своя)
    иначе
        Своя.Реакция = Реакция
    ;
    Сообщение.Записать()
    возврат ДанныеСообщений(Беседа, Собеседник, [Ссылка!]).Первый()
;

@ВПроекте
метод КодыРеакций(): Массив<Строка>
    возврат ["error", "idea", "like"]
;

//Файл ждёт отправки сообщения в ВложенияВебЧата: ссылку на двоичный объект виджету
//отдать нельзя — у неё нет строкового вида, — поэтому виджет получает Ид записи
@ВПроекте
метод ЗагрузитьВложение(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка, ИмяФайла: Строка,
    ТипСодержимого: Строка, Байты: Байты): ЗагруженноеВложение

    исп КонтекстДоступа.Привилегированный()
    знч Файл = ОбъектноеХранилище.Загрузить(ИмяФайла, Байты, ТипСодержимого)
    знч ЭтоИзображение = ["image/jpeg", "image/png", "image/gif", "image/bmp", "image/tiff"].Содержит(ТипСодержимого)
    пер Превью: ДвоичныйОбъект.Ссылка? = Неопределено
    если ЭтоИзображение
        знч Изображение = новый ОбрабатываемоеИзображение(Файл.ОткрытьПотокЧтения())
        Изображение.УстановитьРазмер(100, 150, Истина)
        Превью = ОбъектноеХранилище.Загрузить(ИмяФайла, Изображение.ПолучитьИзображение()).Ссылка
    ;
    знч Запись = новый ВложенияВебЧата.Запись()
    Запись.Ид = новый Ууид()
    Запись.Беседа = Беседа
    Запись.Собеседник = Собеседник
    Запись.Файл = Файл.Ссылка
    Запись.Превью = Превью
    Запись.ИмяФайла = ИмяФайла
    Запись.ЭтоИзображение = ЭтоИзображение
    Запись.Загружено = ДатаВремя.Сейчас()
    ВложенияВебЧата.Записать(Запись)
    возврат новый ЗагруженноеВложение(Ид = Запись.Ид.ВСтроку(), Имя = ИмяФайла, ЭтоИзображение = ЭтоИзображение)
;

//Файл или превью вложения сообщения этой беседы
@ВПроекте
метод ФайлСообщения(Беседа: Беседы.Ссылка, ИдСообщения: Строка, Номер: Число, Превью: Булево): ДвоичныйОбъект.Ссылка?
    знч Ссылка = СообщениеЭтойБеседы(ИдСообщения, Беседа)
    если Ссылка == Неопределено
        возврат Неопределено
    ;
    исп КонтекстДоступа.Привилегированный()
    пер Текущий = 0
    для СтрокаФайла из Ссылка!.ЗагрузитьОбъект().Файлы
        если Текущий == Номер
            возврат Превью и СтрокаФайла.Превью != Неопределено ? СтрокаФайла.Превью : СтрокаФайла.Файл
        ;
        Текущий = Текущий + 1
    ;
    возврат Неопределено
;

@ВПроекте
метод АватарУчастника(Беседа: Беседы.Ссылка, ИдСобеседника: Строка): ДвоичныйОбъект.Ссылка?
    исп КонтекстДоступа.Привилегированный()
    попытка
        //Аватар — участника беседы или автора её сообщения: администратор пишет, не состоя в беседе
        знч Собеседник = новый Собеседники.Ссылка(новый Ууид(ИдСобеседника))
        если КлючиБесед.УчастникБеседы(Беседа, ИдСобеседника) == Неопределено и не АвторВБеседе(Беседа, Собеседник)
            возврат Неопределено
        ;
        возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1
            Собеседники.Аватар КАК Аватар
        ИЗ
            Собеседники КАК Собеседники
        ГДЕ
            Собеседники.Ссылка == %Собеседник
            И НЕ Собеседники.Отключен}.Выполнить().ЕдинственныйИлиНеопределено()?.Аватар
    поймать Исключение: Исключение
        возврат Неопределено
    ;
;

@Локально
метод АвторВБеседе(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка): Булево
    исп Записи = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1
        СообщенияБесед.Ссылка КАК Ссылка
    ИЗ
        СообщенияБесед КАК СообщенияБесед
    ГДЕ
        СообщенияБесед.Беседа == %Беседа
        И СообщенияБесед.Автор == %Собеседник}.Выполнить()
    возврат не Записи.Пусто()
;

//Шапка окна: название и аватар беседы, если потребитель не задал свои — у беседы двоих
//название и аватар у каждого свои, их знает только потребитель. Аватар — путь сервиса:
//ссылку на двоичный объект виджету строкой не передать. «<» экранируется: строка JSON
//стоит внутри тега script, и название с «</script>» закрыло бы его
@ВПроекте
метод ПараметрыДляВиджета(Беседа: Беседы.Ссылка, Ключ: Строка, Заголовок: Строка,
    СобеседникНаАватаре: Собеседники.Ссылка?): Строка

    исп КонтекстДоступа.Привилегированный()
    пер Наименование = Заголовок
    если Наименование == ""
        Наименование = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1
            Беседы.Наименование КАК Наименование
        ИЗ
            Беседы КАК Беседы
        ГДЕ
            Беседы.Ссылка == %Беседа}.Выполнить().ЕдинственныйИлиНеопределено()?.Наименование ?? ""
    ;
    знч Аватар = СобеседникНаАватаре == Неопределено ? "/avatar" : "/avatars/" + СобеседникНаАватаре!.Ид.ВСтроку()
    знч Параметры = новый ПараметрыВиджета(Беседа = Беседа.Ид.ВСтроку(), Ключ = Ключ,
        Наименование = Наименование, Аватар = Аватар)
    возврат СериализацияJson.ЗаписатьОбъект(Параметры).Заменить("<", "\\u003c")
;

@ВПроекте
метод АватарБеседы(Беседа: Беседы.Ссылка): ДвоичныйОбъект.Ссылка?
    исп КонтекстДоступа.Привилегированный()
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1
        Беседы.Аватар КАК Аватар
    ИЗ
        Беседы КАК Беседы
    ГДЕ
        Беседы.Ссылка == %Беседа}.Выполнить().ЕдинственныйИлиНеопределено()?.Аватар
;

//Список участников окна: администраторы беседы в нём не показываются, отключённые — тоже.
//«В сети» — отметка присутствия не старше 30 секунд (ВебЧат.ОтметитьПрисутствие)
@ВПроекте
метод УчастникиБеседы(Беседа: Беседы.Ссылка): Массив<ДанныеУчастника>
    исп КонтекстДоступа.Привилегированный()
    знч Порог = ДатаВремя.Сейчас() - 30с
    исп Записи = Запрос{ВЫБРАТЬ
        УчастникиБесед.Собеседник КАК Собеседник,
        УчастникиБесед.Собеседник.Наименование.ЗаменитьNull("") КАК Имя,
        УчастникиБесед.Состояние КАК Состояние,
        ПрисутствиеСобеседников.ОтмеченВСети.ЗаменитьNull() КАК ОтмеченВСети
    ИЗ
        УчастникиБесед КАК УчастникиБесед
            ЛЕВОЕ СОЕДИНЕНИЕ ПрисутствиеСобеседников КАК ПрисутствиеСобеседников
            ПО УчастникиБесед.Собеседник == ПрисутствиеСобеседников.Собеседник
    ГДЕ
        УчастникиБесед.Беседа == %Беседа
        И УчастникиБесед.Собеседник != Неопределено
        И УчастникиБесед.Состояние != СостоянияУчастникаБеседы.Администратор
        И НЕ УчастникиБесед.Собеседник.Отключен.ЗаменитьNull(Ложь)
    УПОРЯДОЧИТЬ ПО
        УчастникиБесед.Собеседник.Наименование}.Выполнить()
    знч Результат = <ДанныеУчастника>[]
    для Запись из Записи
        Результат.Добавить(новый ДанныеУчастника(Ид = Запись.Собеседник!.Ид.ВСтроку(), Имя = Запись.Имя,
            Состояние = Запись.Состояние == СостоянияУчастникаБеседы.МожетПисать ? "МожетПисать" : "ТолькоЧитает",
            ВСети = Запись.ОтмеченВСети >= Порог))
    ;
    возврат Результат
;

//Писать может участник с состоянием «Может писать» и администратор беседы; состояние — от потребителя
@ВПроекте
метод МожноПисать(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка): Булево
    знч Состояние = ВебЧат.Состояние(Беседа, Собеседник)
    возврат Состояние == СостоянияУчастникаБеседы.МожетПисать или Состояние == СостоянияУчастникаБеседы.Администратор
;

//Вторая линия защиты: виджет сам оставляет только разрешённую разметку, но запрос
//можно отправить и в обход виджета
@ВПроекте
метод ОчиститьРазметку(Текст: Строка): Строка
    возврат Текст
        .Заменить('<script(?=[\s>/]).*?</script\s*>(?is)', "")
        .Заменить('<style(?=[\s>/]).*?</style\s*>(?is)', "")
        .Заменить('</?(script|style|iframe|object|embed|link|meta|form|base)(?=[\s>/])[^>]*>(?i)', "")
        .Заменить('\son[a-z]+\s*=(?i)', " data-off=")
        .Заменить('javascript\s*:(?i)', "")
;

@Локально
метод Кратко(ТекстБезРазметки: Строка): Строка
    знч Строки = ТекстБезРазметки.ПолучитьСтроки()
    возврат Строки.Пусто() ? "" : Строки[0].Обрезать(50)
;

@Локально
метод СообщениеЭтойБеседы(ИдСообщения: Строка, Беседа: Беседы.Ссылка): СообщенияБесед.Ссылка?
    если ИдСообщения == ""
        возврат Неопределено
    ;
    исп КонтекстДоступа.Привилегированный()
    попытка
        знч Ссылка = новый СообщенияБесед.Ссылка(новый Ууид(ИдСообщения))
        возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1
            СообщенияБесед.Ссылка КАК Ссылка
        ИЗ
            СообщенияБесед КАК СообщенияБесед
        ГДЕ
            СообщенияБесед.Ссылка == %Ссылка
            И СообщенияБесед.Беседа == %Беседа
            И НЕ СообщенияБесед.ПометкаУдаления}.Выполнить().ЕдинственныйИлиНеопределено()?.Ссылка
    поймать Исключение: Исключение
        возврат Неопределено
    ;
;

@Локально
метод СвоеСообщение(ИдСообщения: Строка, Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка): СообщенияБесед.Ссылка?
    знч Ссылка = СообщениеЭтойБеседы(ИдСообщения, Беседа)
    если Ссылка == Неопределено
        возврат Неопределено
    ;
    исп КонтекстДоступа.Привилегированный()
    знч Сообщение = Ссылка!.ЗагрузитьОбъект()
    возврат Сообщение.Автор == Собеседник и не Сообщение.Служебное и не Сообщение.УдаленоАдминистратором
        ? Ссылка : Неопределено
;

@Локально
метод ЕстьСообщенияДо(Беседа: Беседы.Ссылка, Номер: Число): Булево
    исп Результат = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1
        СообщенияБесед.Ссылка КАК Ссылка
    ИЗ
        СообщенияБесед КАК СообщенияБесед
    ГДЕ
        СообщенияБесед.Беседа == %Беседа
        И СообщенияБесед.Номер < %Номер
        И НЕ СообщенияБесед.ПометкаУдаления
        И НЕ СообщенияБесед.Автор.Отключен.ЗаменитьNull(Ложь)}.Выполнить()
    возврат не Результат.Пусто()
;

//Данные сообщений по возрастанию номера; реакции отключённых не показываются
@Локально
метод ДанныеСообщений(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка,
    Ссылки: ЧитаемыйМассив<СообщенияБесед.Ссылка>): Массив<ДанныеСообщения>

    знч Результат = <ДанныеСообщения>[]
    если Ссылки.Пусто()
        возврат Результат
    ;
    знч Сообщения = <СообщенияБесед.Объект>[]
    для Ссылка из Ссылки
        Сообщения.Добавить(Ссылка.ЗагрузитьОбъект())
    ;
    знч АвторыРеакций = <Собеседники.Ссылка>[]
    для Сообщение из Сообщения
        для СтрокаРеакции из Сообщение.Реакции
            если СтрокаРеакции.Собеседник != Неопределено
                АвторыРеакций.Добавить(СтрокаРеакции.Собеседник!)
            ;
        ;
    ;
    знч Отключенные = ВебЧат.ОтключенныеИзЧисла(АвторыРеакций)
    знч Состояние = ВебЧат.Состояние(Беседа, Собеседник)
    знч Пишет = Состояние == СостоянияУчастникаБеседы.МожетПисать или Состояние == СостоянияУчастникаБеседы.Администратор
    знч Администратор = Состояние == СостоянияУчастникаБеседы.Администратор

    для Сообщение из Сообщения.Сортировать((А, Б) -> А.Номер - Б.Номер)
        знч Реакции = <ДанныеРеакции>[]
        для Код из КодыРеакций()
            знч Видимые = Сообщение.Реакции.Фильтровать(Стр -> Стр.Реакция == Код
                и Стр.Собеседник != Неопределено и не Отключенные.Содержит(Стр.Собеседник!))
            если не Видимые.Пусто()
                Реакции.Добавить(новый ДанныеРеакции(Код = Код, Количество = Видимые.Размер(),
                    Своя = Видимые.Фильтровать(Стр -> Стр.Собеседник == Собеседник).Размер() > 0))
            ;
        ;
        знч Файлы = <ДанныеФайла>[]
        для СтрокаФайла из Сообщение.Файлы
            Файлы.Добавить(новый ДанныеФайла(Номер = Файлы.Размер(), Имя = СтрокаФайла.ИмяФайла,
                ЭтоИзображение = СтрокаФайла.ЭтоИзображение))
        ;
        знч Ответ = Сообщение.Ответ == Неопределено ? Неопределено : Сообщение.Ответ!.ЗагрузитьОбъект()
        знч Свое = Сообщение.Автор == Собеседник
        знч Обычное = не Сообщение.Служебное и не Сообщение.УдаленоАдминистратором
        Результат.Добавить(новый ДанныеСообщения(
            Ид = Сообщение.Ссылка.Ид.ВСтроку(),
            Номер = Сообщение.Номер,
            День = Сообщение.Дата.Представление("дддд, д ММММ гггг"),
            Время = Сообщение.Дата.Представление("ЧЧ:мм"),
            Версия = Сообщение.МеткаВерсии.ВСтроку(),
            Автор = Сообщение.Автор?.Ид.ВСтроку() ?? "",
            АвторИмя = Сообщение.Автор?.Представление() ?? "",
            Свое = Свое,
            Служебное = Сообщение.Служебное,
            УдаленоАдминистратором = Сообщение.УдаленоАдминистратором,
            Текст = Сообщение.Текст,
            ОтветИд = Ответ == Неопределено ? "" : Ответ!.Ссылка.Ид.ВСтроку(),
            ОтветАвтор = Ответ == Неопределено ? "" : (Ответ!.Автор?.Представление() ?? ""),
            ОтветТекст = Ответ == Неопределено ? "" : Ответ!.ТекстКратко,
            ОтветУдален = Сообщение.ОтветУдален,
            ОтветУдаленАдминистратором = Ответ != Неопределено и Ответ!.УдаленоАдминистратором,
            МожноОтветить = Пишет и не Сообщение.Служебное,
            МожноИзменить = Пишет и Свое и Обычное,
            МожноУдалить = Обычное и (Свое и Пишет или Администратор),
            МожноРеагировать = Состояние == СостоянияУчастникаБеседы.МожетПисать и Обычное,
            Файлы = Файлы,
            Реакции = Реакции))
    ;
    возврат Результат
;
