    пер Ключ: Строка
    пер Наименование: Строка
    пер Аватар: Строка
;

@ВПроекте
структура ДанныеУчастника
    пер Ид: Строка
    пер Имя: Строка
    пер Состояние: Строка
    пер ВСети: Булево
;

@ВПроекте
структура ИзвестноеСообщение
    пер Ид: Строка
    пер Версия: Строка
;

@ВПроекте
структура ЗапросИзменений
    пер Последний: Число
    пер Известные: Массив<ИзвестноеСообщение>
;

@ВПроекте
структура Изменения
