//Переписка для виджета: что отдаёт и что принимает ВебЧатHttpСервис. Собеседник здесь
//всегда тот, кого назвал ключ виджета; участие проверено до вызова (КлючиБесед), а что ему
//можно — по состоянию в беседе, которое передал потребитель

конст РАЗМЕР_ПОРЦИИ = 20

@ВПроекте
структура ДанныеФайла
    пер Номер: Число
    пер Имя: Строка
    пер ЭтоИзображение: Булево
;

@ВПроекте
структура ДанныеРеакции
