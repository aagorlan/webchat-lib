    пер Количество: Число
    пер Своя: Булево
;

@ВПроекте
структура ДанныеСообщения
    пер Ид: Строка
    пер Номер: Число
    пер День: Строка
    пер Время: Строка
    пер Версия: Строка
    пер Автор: Строка
    пер АвторИмя: Строка
    пер Свое: Булево
    пер Служебное: Булево
    пер УдаленоАдминистратором: Булево
    пер Текст: Строка
    пер ОтветИд: Строка
    пер ОтветАвтор: Строка
    пер ОтветТекст: Строка
    пер ОтветУдален: Булево
    пер ОтветУдаленАдминистратором: Булево
    пер МожноОтветить: Булево
    пер МожноИзменить: Булево
    пер МожноУдалить: Булево
    пер МожноРеагировать: Булево
    пер Файлы: Массив<ДанныеФайла>
    пер Реакции: Массив<ДанныеРеакции>
;

@ВПроекте
структура Порция
    пер Сообщения: Массив<ДанныеСообщения>
    пер ЕстьРаньше: Булево
    пер ПервоеНепрочитанное: Число
    пер МожноПисать: Булево
    пер Я: Строка
;

//Что виджет получает при открытии: подставляется в страницу целиком, одной строкой JSON
@ВПроекте
структура ПараметрыВиджета
