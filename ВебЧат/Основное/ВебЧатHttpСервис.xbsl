//Сервис открыт платформой всем: доступ держится на ключе виджета (КлючиБесед).
//Ключ — в заголовке Authorization, беседа — в адресе; автор действия — всегда собеседник ключа

//Исключение обработчика записывается в журнал событий (ОшибкаВебЧата): без этого платформа
//отвечала 500 с пустым телом, а в журнале не оставалось ничего
метод Ping(Запрос: HttpСервисЗапрос)
    попытка
        ОбработатьPing(Запрос)
    поймать Исключение: Исключение
        ОшибкаСервиса(Запрос, "Ping", Исключение)
    ;
;

метод Сообщения(Запрос: HttpСервисЗапрос)
