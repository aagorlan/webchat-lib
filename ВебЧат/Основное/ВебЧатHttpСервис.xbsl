@Локально
метод ОшибкаСервиса(Запрос: HttpСервисЗапрос, Обработчик: Строка, Исключение: Исключение)
    новый ОшибкаВебЧата(
        Операция = Обработчик + " " + Запрос.Метод,
        ОписаниеОшибки = Исключение.Описание,
        ИнформацияДляПоддержки = Исключение.ПоследовательностьВызовов
    ).Записать()
    Отказать(Запрос, 500, "внутренняя ошибка веб-чата, подробности — в журнале событий")
;

@Локально
метод ОбработатьPing(Запрос: HttpСервисЗапрос)
    знч Допуск = Допуск(Запрос)
    если Допуск == Неопределено
        возврат
    ;
    ОтветитьJson(Запрос, {"ok": Истина})
;

@Локально
метод ОбработатьСообщения(Запрос: HttpСервисЗапрос)
    знч Допуск = Допуск(Запрос)
    если Допуск == Неопределено
        возврат
    ;
    выбор Запрос.Метод
    когда "GET"
        знч До = Запрос.Параметры.ПолучитьПервый("before") ?? "0"
        ОтветитьJson(Запрос, ПерепискаВебЧата.ПолучитьПорцию(Допуск!.Беседа, Допуск!.Собеседник, ЧислоИлиНоль(До)))
    когда "POST"
        знч Черновик = СериализацияJson.ПрочитатьОбъект(Запрос.Тело.ПрочитатьКакСтроку(),
            Тип<ПерепискаВебЧата.ЧерновикСообщения>)
        знч Данные = ПерепискаВебЧата.Отправить(Допуск!.Беседа, Допуск!.Собеседник, Черновик)
        если Данные == Неопределено
            Отказать(Запрос, 403, "писать в беседу нельзя")
            возврат
        ;
        ОтветитьJson(Запрос, Данные!)
    иначе
        Отказать(Запрос, 405, "метод не поддерживается")
    ;
;

@Локально
метод ОбработатьСообщение(Запрос: HttpСервисЗапрос)
    знч Допуск = Допуск(Запрос)
    если Допуск == Неопределено
        возврат
    ;
    знч Ид = Запрос.Параметры.ПолучитьПервый("message") ?? ""
    выбор Запрос.Метод
    когда "PUT"
        знч Черновик = СериализацияJson.ПрочитатьОбъект(Запрос.Тело.ПрочитатьКакСтроку(),
            Тип<ПерепискаВебЧата.ЧерновикСообщения>)
        знч Данные = ПерепискаВебЧата.Изменить(Допуск!.Беседа, Допуск!.Собеседник, Ид, Черновик)
        если Данные == Неопределено
            Отказать(Запрос, 404, "своего сообщения с таким идентификатором нет")
            возврат
        ;
        ОтветитьJson(Запрос, Данные!)
    когда "DELETE"
        если не ПерепискаВебЧата.Удалить(Допуск!.Беседа, Допуск!.Собеседник, Ид)
            Отказать(Запрос, 404, "своего сообщения с таким идентификатором нет")
            возврат
        ;
        Запрос.Ответ.КодСтатуса = 204
    иначе
        Отказать(Запрос, 405, "метод не поддерживается")
    ;
;

@Локально
метод ОбработатьРеакция(Запрос: HttpСервисЗапрос)
    знч Допуск = Допуск(Запрос)
    если Допуск == Неопределено
        возврат
    ;
    если Запрос.Метод != "POST"
        Отказать(Запрос, 405, "метод не поддерживается")
        возврат
    ;
    знч Выбор = СериализацияJson.ПрочитатьОбъект(Запрос.Тело.ПрочитатьКакСтроку(), Тип<ПерепискаВебЧата.ВыборРеакции>)
    знч Данные = ПерепискаВебЧата.ПереключитьРеакцию(Допуск!.Беседа, Допуск!.Собеседник,
        Запрос.Параметры.ПолучитьПервый("message") ?? "", Выбор.Реакция)
    если Данные == Неопределено
        Отказать(Запрос, 404, "сообщения или реакции нет")
        возврат
    ;
    ОтветитьJson(Запрос, Данные!)
;

@Локально
метод ОбработатьСинхронизация(Запрос: HttpСервисЗапрос)
    знч Допуск = Допуск(Запрос)
    если Допуск == Неопределено
        возврат
    ;
    если Запрос.Метод != "POST"
        Отказать(Запрос, 405, "метод не поддерживается")
        возврат
    ;
    знч ЧтоЕсть = СериализацияJson.ПрочитатьОбъект(Запрос.Тело.ПрочитатьКакСтроку(),
        Тип<ПерепискаВебЧата.ЗапросИзменений>)
    ОтветитьJson(Запрос, ПерепискаВебЧата.ПолучитьИзменения(Допуск!.Беседа, Допуск!.Собеседник, ЧтоЕсть))
;

//Тело — сам файл; имя — параметром запроса name: параметры платформа раскодирует сама
@Локально
метод ОбработатьЗагрузка(Запрос: HttpСервисЗапрос)
    знч Допуск = Допуск(Запрос)
    если Допуск == Неопределено
        возврат
    ;
    если Запрос.Метод != "POST"
        Отказать(Запрос, 405, "метод не поддерживается")
        возврат
    ;
    если не ПерепискаВебЧата.МожноПисать(Допуск!.Беседа, Допуск!.Собеседник)
        Отказать(Запрос, 403, "писать в беседу нельзя")
        возврат
    ;
    знч Имя = Запрос.Параметры.ПолучитьПервый("name") ?? "файл"
    знч ТипСодержимого = Запрос.Заголовки.ПолучитьПервый("Content-Type") ?? "application/octet-stream"
    ОтветитьJson(Запрос, ПерепискаВебЧата.ЗагрузитьВложение(Допуск!.Беседа, Допуск!.Собеседник, Имя,
        ТипСодержимого, Запрос.Тело.ПрочитатьКакБайты()))
;

@Локально
метод ОбработатьФайл(Запрос: HttpСервисЗапрос)
    знч Допуск = Допуск(Запрос)
    если Допуск == Неопределено
        возврат
    ;
    знч Файл = ПерепискаВебЧата.ФайлСообщения(Допуск!.Беседа, Запрос.Параметры.ПолучитьПервый("message") ?? "",
        ЧислоИлиНоль(Запрос.Параметры.ПолучитьПервый("index") ?? "0"),
        Запрос.Параметры.ПолучитьПервый("preview") == "1")
    если Файл == Неопределено
        Отказать(Запрос, 404, "файла нет")
        возврат
    ;
    Запрос.Ответ.УстановитьТело(Файл!)
;

@Локально
метод ОбработатьАватар(Запрос: HttpСервисЗапрос)
    знч Допуск = Допуск(Запрос)
    если Допуск == Неопределено
        возврат
    ;
    знч Файл = ПерепискаВебЧата.АватарУчастника(Допуск!.Беседа, Запрос.Параметры.ПолучитьПервый("member") ?? "")
    если Файл == Неопределено
        Запрос.Ответ.КодСтатуса = 204
        возврат
    ;
    Запрос.Ответ.УстановитьТело(Файл!)
;

@Локально
метод ОбработатьАватарЧата(Запрос: HttpСервисЗапрос)
    знч Допуск = Допуск(Запрос)
    если Допуск == Неопределено
        возврат
    ;
    знч Файл = ПерепискаВебЧата.АватарБеседы(Допуск!.Беседа)
    если Файл == Неопределено
        Запрос.Ответ.КодСтатуса = 204
        возврат
    ;
    Запрос.Ответ.УстановитьТело(Файл!)
;

@Локально
метод ОбработатьСоставБеседы(Запрос: HttpСервисЗапрос)
    знч Допуск = Допуск(Запрос)
    если Допуск == Неопределено
        возврат
    ;
    ОтветитьJson(Запрос, ПерепискаВебЧата.УчастникиБеседы(Допуск!.Беседа))
;

@Локально
структура ДопускЗапроса
    обз знч Беседа: Беседы.Ссылка
    обз знч Собеседник: Собеседники.Ссылка
;

//Беседа из адреса и собеседник из ключа; не сошлось — ответ 401 уже отправлен
@Локально
метод Допуск(Запрос: HttpСервисЗапрос): ДопускЗапроса?
    знч Заголовок = Запрос.Заголовки.ПолучитьПервый("Authorization") ?? ""
    знч Ключ = Заголовок.НачинаетсяС("Bearer ") ? Заголовок.Подстрока(7) : ""
    пер Беседа: Беседы.Ссылка? = Неопределено
    попытка
        Беседа = новый Беседы.Ссылка(новый Ууид(Запрос.Параметры.ПолучитьПервый("chat") ?? ""))
    поймать Исключение: Исключение
        Беседа = Неопределено
    ;
    знч Собеседник = Ключ == "" или Беседа == Неопределено ? Неопределено : КлючиБесед.СобеседникПоКлючу(Ключ, Беседа!)
    если Собеседник == Неопределено
        знч Причина = Ключ == "" или Беседа == Неопределено ? "нет ключа или беседы" : КлючиБесед.ПричинаОтказа(Ключ, Беседа!)
        Отказать(Запрос, 401, "доступ к беседе закрыт: " + Причина)
        возврат Неопределено
    ;
    возврат новый ДопускЗапроса(Беседа = Беседа!, Собеседник = Собеседник!)
;

@Локально
метод ОтветитьJson(Запрос: HttpСервисЗапрос, Данные: Объект?)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json; charset=utf-8")
    Запрос.Ответ.Заголовки.Установить("Cache-Control", "no-store")
    Запрос.Ответ.УстановитьТело(СериализацияJson.ЗаписатьОбъект(Данные))
;

@Локально
метод Отказать(Запрос: HttpСервисЗапрос, Код: Число, Причина: Строка)
    Запрос.Ответ.КодСтатуса = Код
    ОтветитьJson(Запрос, {"reason": Причина})
;

@Локально
метод ЧислоИлиНоль(Текст: Строка): Число
    попытка
        возврат новый Число(Текст)
    поймать Исключение: Исключение
        возврат 0
    ;
;
