//Окно беседы для форм потребителя — только виджет переписки; пояснения и кнопки членства
//показывает потребитель. Таймер раз в секунду к серверу не ходит —
//замечает смену беседы или версии; сервер — при смене и раз в 10 минут, чтобы продлить ключ
//виджета (срок ключа — 30 минут, КлючиБесед). Версию потребитель увеличивает, когда сменил
//состояние собеседника в беседе: окно перечитывает её, и виджет получает новые права.
//Заголовок и собеседник на аватаре — для шапки окна; не заданы — название и аватар беседы
@НаКлиенте @НаСервере
конст ПРОДЛЕВАТЬ_КЛЮЧ_СЕКУНД = 600

@Обработчик
метод ПослеСоздания()
    ПодключитьОбработчикТаймера(&Проверка, 1с, Ложь)
;

@Локально
метод Проверка()
    если Беседа != ОткрытаяБеседа или Версия != ОткрытаяВерсия
        ОткрытьБеседу()
        возврат
    ;
    Секунд = Секунд + 1
    если Секунд >= ПРОДЛЕВАТЬ_КЛЮЧ_СЕКУНД и Беседа != Неопределено и СодержимоеВиджета != ""
        Секунд = 0
        знч Ключ = НовыйКлюч(Беседа!)
        попытка
            Компоненты.Переписка.УстановитьПеременную("chatKey", Ключ)
        поймать Исключение: ИсключениеВыполненияJs
            //блок ещё не загрузился — повторим через минуту, срок ключа это позволяет
            Секунд = ПРОДЛЕВАТЬ_КЛЮЧ_СЕКУНД - 60
        ;
    ;
;

@Локально
метод ОткрытьБеседу()
    ОткрытаяБеседа = Беседа
    ОткрытаяВерсия = Версия
    Секунд = 0
    СодержимоеВиджета = Беседа == Неопределено ? "" : Содержимое(Беседа!, ЗаголовокБеседы, СобеседникНаАватаре)
;

//Параметры виджета подставляются в текст ресурса: так он стартует сам, без ВызватьМетод,
//который до загрузки DOM падает и требует повтора по таймеру. Нет ключа — окно пусто
@Локально
@НаСервере @ДоступноСКлиента
статический метод Содержимое(Беседа: Беседы.Ссылка, Заголовок: Строка,
    СобеседникНаАватаре: Собеседники.Ссылка?): Строка

    знч Ключ = НовыйКлюч(Беседа)
    если Ключ == ""
        возврат ""
    ;
    возврат Ресурс{ВиджетБеседы.html}.ОткрытьПотокЧтения().ПрочитатьКакСтроку()
        .Заменить("@@ПАРАМЕТРЫ@@", ПерепискаВебЧата.ПараметрыДляВиджета(Беседа, Ключ, Заголовок, СобеседникНаАватаре))
;

@Локально
@НаСервере @ДоступноСКлиента
статический метод НовыйКлюч(Беседа: Беседы.Ссылка): Строка
    знч Собеседник = ВебЧат.ТекущийСобеседник()
    возврат Собеседник == Неопределено ? "" : КлючиБесед.ВыдатьКлюч(Собеседник!, Беседа)
;
