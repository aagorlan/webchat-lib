//Программный интерфейс библиотеки. Библиотека — отражение групп потребителя: собеседников,
//беседы и состав с состоянием каждого передаёт потребитель, сама она не заводит бесед
//и прав не вычисляет. Хранит переписку и прочтение. Сущности видят только администраторы,
//остальное — через этот интерфейс в привилегированном контексте

@Глобально
структура СтрокаСпискаБесед
    обз знч Беседа: Беседы.Ссылка
    обз знч Наименование: Строка
    обз знч Аватар: ДвоичныйОбъект.Ссылка?
;

@Глобально
структура СводкаБеседы
    обз знч Беседа: Беседы.Ссылка
    обз знч Наименование: Строка
    обз знч Новых: Число
    обз знч СРеакциями: Число
    обз знч СОтветами: Число
;

@Глобально
структура МатериалыСобеседника
    обз знч Сообщений: Число
    обз знч Файлов: Число
    обз знч Реакций: Число
    обз знч Бесед: Число
;

//Собеседник текущего сеанса называет потребитель (СеансВебЧата)
@Глобально
метод ТекущийСобеседник(): Собеседники.Ссылка?
    возврат СеансВебЧата.ПолучитьСервис().ТекущийСобеседник()
;

//Собеседник с идентификатором участника потребителя: нет такого — заводится, есть — обновляется
//то, что изменилось. Ссылку потребитель строит сам: новый Собеседники.Ссылка(Ид)
@Глобально
метод ОбновитьСобеседника(Ид: Ууид, Наименование: Строка, Аватар: ДвоичныйОбъект.Ссылка?): Собеседники.Ссылка
    исп КонтекстДоступа.Привилегированный()
    знч Ссылка = новый Собеседники.Ссылка(Ид)
    знч Новый = не СобеседникЕсть(Ссылка)
    знч Объект = Новый ? новый Собеседники.Объект(Ид = Ид) : Ссылка.ЗагрузитьОбъект()
    если не Новый и Объект.Наименование == Наименование и Объект.Аватар == Аватар
        возврат Ссылка
    ;
    Объект.Наименование = Наименование
    Объект.Аватар = Аватар
    Объект.Записать()
    возврат Ссылка
;

//Отключённый собеседник пропадает для остальных: его сообщения и реакции скрыты, ключ
//виджета у него не действует. Отключить = Ложь — всё возвращается
@Глобально
метод ОтключитьУчастника(Собеседник: Собеседники.Ссылка, Отключить: Булево)
    исп КонтекстДоступа.Привилегированный()
    если не СобеседникЕсть(Собеседник)
        возврат
    ;
    знч Объект = Собеседник.ЗагрузитьОбъект()
    если Объект.Отключен == Отключить
        возврат
    ;
    Объект.Отключен = Отключить
    Объект.Записать()
;

//Удаление участника: его сообщения пропадают с файлами, его реакции на чужое — тоже,
//ответы других теряют цитату («Сообщение удалено»); он выходит из всех бесед, а копия
//его имени и аватара удаляется вместе с ним
@Глобально
метод УдалитьУчастника(Собеседник: Собеседники.Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Ответы = Запрос{ВЫБРАТЬ
        СообщенияБесед.Ссылка КАК Ссылка
    ИЗ
        СообщенияБесед КАК СообщенияБесед
    ГДЕ
        СообщенияБесед.Ответ.Автор == %Собеседник
        И СообщенияБесед.Автор != %Собеседник}.Выполнить()
    для СтрокаОтвета из Ответы
        знч Ответ = СтрокаОтвета.Ссылка.ЗагрузитьОбъект()
        Ответ.Ответ = Неопределено
        Ответ.ОтветУдален = Истина
        Ответ.Записать()
    ;

    исп СРеакциями = Запрос{ВЫБРАТЬ РАЗЛИЧНЫЕ
        Реакции.Владелец КАК Ссылка
    ИЗ
        СообщенияБесед.Реакции КАК Реакции
    ГДЕ
        Реакции.Собеседник == %Собеседник
        И Реакции.Владелец.Автор != %Собеседник}.Выполнить()
    для СтрокаСообщения из СРеакциями
        знч Сообщение = СтрокаСообщения.Ссылка.ЗагрузитьОбъект()
        для СтрокаРеакции из Сообщение.Реакции.Фильтровать(Стр -> Стр.Собеседник == Собеседник)
            Сообщение.Реакции.Удалить(СтрокаРеакции)
        ;
        Сообщение.Записать()
    ;

    знч Файлы = <ДвоичныйОбъект.Ссылка>[]
    исп Свои = Запрос{ВЫБРАТЬ
        СообщенияБесед.Ссылка КАК Ссылка
    ИЗ
        СообщенияБесед КАК СообщенияБесед
    ГДЕ
        СообщенияБесед.Автор == %Собеседник}.Выполнить()
    для СтрокаСообщения из Свои
        УдалитьСообщениеСФайлами(СтрокаСообщения.Ссылка, Файлы)
    ;

    исп Участие = Запрос{ВЫБРАТЬ
        УчастникиБесед.Беседа КАК Беседа
    ИЗ
        УчастникиБесед КАК УчастникиБесед
    ГДЕ
        УчастникиБесед.Собеседник == %Собеседник}.Выполнить()
    для СтрокаУчастия из Участие
        УчастникиБесед.Удалить(новый УчастникиБесед.КлючЗаписи(Беседа = СтрокаУчастия.Беседа!, Собеседник = Собеседник))
        ПрочтениеБесед.Удалить(новый ПрочтениеБесед.КлючЗаписи(Беседа = СтрокаУчастия.Беседа!, Собеседник = Собеседник))
    ;
    если не Файлы.Пусто()
        ОбъектноеХранилище.УстановитьНеиспользуемые(Файлы)
    ;
    ПрисутствиеСобеседников.Удалить(новый ПрисутствиеСобеседников.КлючЗаписи(Собеседник = Собеседник))
    если СобеседникЕсть(Собеседник)
        Собеседник.ЗагрузитьОбъект().Удалить()
    ;
;

//Беседа с идентификатором объекта потребителя: нет такой — заводится, есть — меняются
//название и аватар, если стали другими
@Глобально
метод ОтразитьБеседу(Ид: Ууид, Наименование: Строка, Аватар: ДвоичныйОбъект.Ссылка?): Беседы.Ссылка
    исп КонтекстДоступа.Привилегированный()
    знч Ссылка = новый Беседы.Ссылка(Ид)
    знч Новая = не БеседаЕсть(Ссылка)
    знч Объект = Новая ? новый Беседы.Объект(Ид = Ид) : Ссылка.ЗагрузитьОбъект()
    если не Новая и Объект.Наименование == Наименование и Объект.Аватар == Аватар
        возврат Ссылка
    ;
    Объект.Наименование = Наименование
    Объект.Аватар = Аватар
    если Новая
        Объект.Создана = ДатаВремя.Сейчас()
    ;
    Объект.Записать()
    возврат Ссылка
;

//Состояние собеседника в беседе; Неопределено — собеседник исключается. Новый участник
//видит прежнюю переписку, но непрочитанной она у него не считается
@Глобально
метод ОтразитьУчастника(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка, Состояние: СостоянияУчастникаБеседы?)
    исп КонтекстДоступа.Привилегированный()
    знч Ключ = новый УчастникиБесед.КлючЗаписи(Беседа = Беседа, Собеседник = Собеседник)
    знч Запись = Ключ.ЗагрузитьЗапись()
    если Состояние == Неопределено
        если Запись != Неопределено
            УчастникиБесед.Удалить(Ключ)
            ПрочтениеБесед.Удалить(новый ПрочтениеБесед.КлючЗаписи(Беседа = Беседа, Собеседник = Собеседник))
        ;
        возврат
    ;
    если Запись != Неопределено
        если Запись.Состояние != Состояние
            Запись.Состояние = Состояние!
            Запись.ИзменениеСостояния = ДатаВремя.Сейчас()
            УчастникиБесед.Записать(Запись)
        ;
        возврат
    ;
    знч Новая = новый УчастникиБесед.Запись()
    Новая.Беседа = Беседа
    Новая.Собеседник = Собеседник
    Новая.Состояние = Состояние!
    Новая.ИзменениеСостояния = ДатаВремя.Сейчас()
    УчастникиБесед.Записать(Новая)

    знч Прочтение = новый ПрочтениеБесед.Запись()
    Прочтение.Беседа = Беседа
    Прочтение.Собеседник = Собеседник
    Прочтение.ПоследнийПрочитанный = ПоследнийНомер(Беседа)
    ПрочтениеБесед.Записать(Прочтение)
;

@Глобально
метод Состояние(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка): СостоянияУчастникаБеседы?
    исп КонтекстДоступа.Привилегированный()
    возврат новый УчастникиБесед.КлючЗаписи(Беседа = Беседа, Собеседник = Собеседник).ЗагрузитьЗапись()?.Состояние
;

//Служебная строка в переписке — «… покинул чат»: без автора, без кнопок, непрочитанной не считается
@Глобально
метод ДобавитьСобытие(Беседа: Беседы.Ссылка, Текст: Строка)
    исп КонтекстДоступа.Привилегированный()
    знч Сообщение = новый СообщенияБесед.Объект()
    Сообщение.Беседа = Беседа
    Сообщение.Дата = ДатаВремя.Сейчас()
    Сообщение.Текст = ПерепискаВебЧата.ОчиститьРазметку(Текст)
    Сообщение.ТекстКратко = Текст.Обрезать(50)
    Сообщение.Служебное = Истина
    Сообщение.Записать()
;

//Беседа целиком: участники, прочтение, сообщения с файлами и сама беседа
@Глобально
метод УдалитьБеседу(Беседа: Беседы.Ссылка)
    исп КонтекстДоступа.Привилегированный()
    если не БеседаЕсть(Беседа)
        возврат
    ;
    исп Участники = Запрос{ВЫБРАТЬ
        УчастникиБесед.Собеседник КАК Собеседник
    ИЗ
        УчастникиБесед КАК УчастникиБесед
    ГДЕ
        УчастникиБесед.Беседа == %Беседа}.Выполнить()
    для Участник из Участники
        если Участник.Собеседник != Неопределено
            УчастникиБесед.Удалить(новый УчастникиБесед.КлючЗаписи(Беседа = Беседа, Собеседник = Участник.Собеседник!))
            ПрочтениеБесед.Удалить(новый ПрочтениеБесед.КлючЗаписи(Беседа = Беседа, Собеседник = Участник.Собеседник!))
        ;
    ;
    знч Файлы = <ДвоичныйОбъект.Ссылка>[]
    исп Сообщения = Запрос{ВЫБРАТЬ
        СообщенияБесед.Ссылка КАК Ссылка
    ИЗ
        СообщенияБесед КАК СообщенияБесед
    ГДЕ
        СообщенияБесед.Беседа == %Беседа}.Выполнить()
    для Сообщение из Сообщения
        УдалитьСообщениеСФайлами(Сообщение.Ссылка, Файлы)
    ;
    Беседа.ЗагрузитьОбъект().Удалить()
    если не Файлы.Пусто()
        ОбъектноеХранилище.УстановитьНеиспользуемые(Файлы)
    ;
;

//Все беседы — для закладки администратора; что показать остальным, решает потребитель по своим группам
@Глобально
метод СписокБесед(): Массив<СтрокаСпискаБесед>
    исп КонтекстДоступа.Привилегированный()
    исп Записи = Запрос{ВЫБРАТЬ
        Беседы.Ссылка КАК Беседа,
        Беседы.Наименование КАК Наименование,
        Беседы.Аватар КАК Аватар
    ИЗ
        Беседы КАК Беседы
    ГДЕ
        НЕ Беседы.ПометкаУдаления}.Выполнить()
    знч Строки = <СтрокаСпискаБесед>[]
    для Запись из Записи
        Строки.Добавить(новый СтрокаСпискаБесед(Беседа = Запись.Беседа, Наименование = Запись.Наименование,
            Аватар = Запись.Аватар))
    ;
    возврат Строки
;

//Сообщения не прочитаны, если их номер больше последнего прочитанного; свои, служебные
//и отключённых не считаются; у администратора в беседе непрочитанного нет
@Глобально
метод НепрочитанныхВсего(Собеседник: Собеседники.Ссылка): Число
    пер Всего = 0
    для Элемент из НепрочитанныхПоБеседам(Собеседник)
        Всего += Элемент.Значение
    ;
    возврат Всего
;

@Глобально
метод НепрочитанныхПоБеседам(Собеседник: Собеседники.Ссылка): Соответствие<Беседы.Ссылка, Число>
    исп КонтекстДоступа.Привилегированный()
    знч Результат = <Беседы.Ссылка, Число>{:}
    исп Записи = Запрос{ВЫБРАТЬ
        СообщенияБесед.Беседа КАК Беседа,
        КОЛИЧЕСТВО(СообщенияБесед.Ссылка) КАК Количество
    ИЗ
        СообщенияБесед КАК СообщенияБесед
            ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПрочтениеБесед КАК ПрочтениеБесед
            ПО СообщенияБесед.Беседа == ПрочтениеБесед.Беседа
            И ПрочтениеБесед.Собеседник == %Собеседник
            ВНУТРЕННЕЕ СОЕДИНЕНИЕ УчастникиБесед КАК УчастникиБесед
            ПО СообщенияБесед.Беседа == УчастникиБесед.Беседа
            И УчастникиБесед.Собеседник == %Собеседник
    ГДЕ
        СообщенияБесед.Номер > ПрочтениеБесед.ПоследнийПрочитанный
        И СообщенияБесед.Автор != %Собеседник
        И НЕ СообщенияБесед.Служебное
        И НЕ СообщенияБесед.Автор.Отключен
        И НЕ СообщенияБесед.ПометкаУдаления
        И УчастникиБесед.Состояние != СостоянияУчастникаБеседы.Администратор
    СГРУППИРОВАТЬ ПО
        СообщенияБесед.Беседа}.Выполнить()
    для Запись из Записи
        если Запись.Беседа != Неопределено
            Результат.Вставить(Запись.Беседа!, Запись.Количество)
        ;
    ;
    возврат Результат
;

//Собеседник в сети, пока его приложение открыто: потребитель отмечает его по таймеру (у сети —
//меню, раз в 10 секунд). Запись — не чаще раза в 15 секунд, «в сети» — отметка не старше 30
@Глобально
метод ОтметитьПрисутствие(Собеседник: Собеседники.Ссылка)
    исп КонтекстДоступа.Привилегированный()
    знч Ключ = новый ПрисутствиеСобеседников.КлючЗаписи(Собеседник = Собеседник)
    знч Прежняя = Ключ.ЗагрузитьЗапись()
    знч Сейчас = ДатаВремя.Сейчас()
    если Прежняя != Неопределено и Прежняя!.ОтмеченВСети > Сейчас - 15с
        возврат
    ;
    если Прежняя == Неопределено и не СобеседникЕсть(Собеседник)
        возврат
    ;
    знч Запись = новый ПрисутствиеСобеседников.Запись()
    Запись.Собеседник = Собеседник
    Запись.ОтмеченВСети = Сейчас
    ПрисутствиеСобеседников.Записать(Запись)
;

@ВПроекте
метод ОтметитьПрочитанной(Беседа: Беседы.Ссылка, Собеседник: Собеседники.Ссылка)
    исп КонтекстДоступа.Привилегированный()
    знч Последний = ПоследнийНомер(Беседа)
    знч Запись = новый ПрочтениеБесед.КлючЗаписи(Беседа = Беседа, Собеседник = Собеседник).ЗагрузитьЗапись()
    если Запись == Неопределено или Запись.ПоследнийПрочитанный >= Последний
        возврат
    ;
    Запись.ПоследнийПрочитанный = Последний
    ПрочтениеБесед.Записать(Запись)
;

@ВПроекте
метод ПоследнийНомер(Беседа: Беседы.Ссылка): Число
    исп КонтекстДоступа.Привилегированный()
    возврат Запрос{ВЫБРАТЬ
        МАКСИМУМ(СообщенияБесед.Номер).ЗаменитьNull(0) КАК Номер
    ИЗ
        СообщенияБесед КАК СообщенияБесед
    ГДЕ
        СообщенияБесед.Беседа == %Беседа}.Выполнить().ЕдинственныйИлиНеопределено()?.Номер ?? 0
;

//Сводка для письма: сколько новых сообщений, сколько сообщений с реакциями и с ответами
//за период по беседам собеседника; свои, служебные и отключённых не считаются
@Глобально
метод Сводка(Собеседник: Собеседники.Ссылка, С: ДатаВремя, По: ДатаВремя): Массив<СводкаБеседы>
    исп КонтекстДоступа.Привилегированный()
    знч СвоиБеседы = БеседыСобеседника(Собеседник)
    знч Строки = <СводкаБеседы>[]
    если СвоиБеседы.Пусто()
        возврат Строки
    ;
    знч СРеакциями = <Беседы.Ссылка, Число>{:}
    исп Реакции = Запрос{ВЫБРАТЬ
        Отмеченные.Беседа КАК Беседа,
        КОЛИЧЕСТВО(Отмеченные.Сообщение) КАК Количество
    ИЗ (ВЫБРАТЬ РАЗЛИЧНЫЕ
            Реакции.Владелец.Беседа.ЗаменитьNull(Неопределено) КАК Беседа,
            Реакции.Владелец КАК Сообщение
        ИЗ
            СообщенияБесед.Реакции КАК Реакции
        ГДЕ
            Реакции.Владелец.Беседа В (%СвоиБеседы)
            И Реакции.Владелец.Дата > %С
            И Реакции.Владелец.Дата <= %По
            И НЕ Реакции.Владелец.Автор.Отключен
            И НЕ Реакции.Владелец.ПометкаУдаления
            И НЕ Реакции.Собеседник.Отключен) КАК Отмеченные
    СГРУППИРОВАТЬ ПО
        Отмеченные.Беседа}.Выполнить()
    для Итог из Реакции
        СРеакциями.Вставить(Итог.Беседа!, Итог.Количество)
    ;
    знч СОтветами = <Беседы.Ссылка, Число>{:}
    исп Ответы = Запрос{ВЫБРАТЬ
        Отвеченные.Беседа КАК Беседа,
        КОЛИЧЕСТВО(Отвеченные.Сообщение) КАК Количество
    ИЗ (ВЫБРАТЬ РАЗЛИЧНЫЕ
            Ответы.Беседа КАК Беседа,
            Ответы.Ответ КАК Сообщение
        ИЗ
            СообщенияБесед КАК Ответы
        ГДЕ
            Ответы.Беседа В (%СвоиБеседы)
            И Ответы.Дата > %С
            И Ответы.Дата <= %По
            И Ответы.Ответ != Неопределено
            И НЕ Ответы.Автор.Отключен
            И НЕ Ответы.ПометкаУдаления
            И НЕ Ответы.Ответ.Автор.Отключен) КАК Отвеченные
    СГРУППИРОВАТЬ ПО
        Отвеченные.Беседа}.Выполнить()
    для Итог из Ответы
        СОтветами.Вставить(Итог.Беседа!, Итог.Количество)
    ;
    исп Новые = Запрос{ВЫБРАТЬ
        СообщенияБесед.Беседа КАК Беседа,
        СообщенияБесед.Беседа.Наименование.ЗаменитьNull("") КАК Наименование,
        КОЛИЧЕСТВО(СообщенияБесед.Ссылка) КАК Новых
    ИЗ
        СообщенияБесед КАК СообщенияБесед
    ГДЕ
        СообщенияБесед.Беседа В (%СвоиБеседы)
        И СообщенияБесед.Дата > %С
        И СообщенияБесед.Дата <= %По
        И СообщенияБесед.Автор != %Собеседник
        И НЕ СообщенияБесед.Служебное
        И НЕ СообщенияБесед.Автор.Отключен
        И НЕ СообщенияБесед.ПометкаУдаления
    СГРУППИРОВАТЬ ПО
        СообщенияБесед.Беседа,
        СообщенияБесед.Беседа.Наименование
    УПОРЯДОЧИТЬ ПО
        Новых УБЫВ}.Выполнить()
    для Итог из Новые
        знч Беседа = Итог.Беседа!
        Строки.Добавить(новый СводкаБеседы(Беседа = Беседа, Наименование = Итог.Наименование, Новых = Итог.Новых,
            СРеакциями = СРеакциями.ПолучитьИлиНеопределено(Беседа) ?? 0,
            СОтветами = СОтветами.ПолучитьИлиНеопределено(Беседа) ?? 0))
    ;
    возврат Строки
;

//Число сообщений в заданных беседах — каталогу областей надо знать, где уже идёт разговор
@Глобально
метод СообщенийПоБеседам(БеседыДляПодсчета: ЧитаемыйМассив<Беседы.Ссылка>): Соответствие<Беседы.Ссылка, Число>
    исп КонтекстДоступа.Привилегированный()
    знч Результат = <Беседы.Ссылка, Число>{:}
    если БеседыДляПодсчета.Пусто()
        возврат Результат
    ;
    исп Записи = Запрос{ВЫБРАТЬ
        СообщенияБесед.Беседа КАК Беседа,
        КОЛИЧЕСТВО(СообщенияБесед.Ссылка) КАК Количество
    ИЗ
        СообщенияБесед КАК СообщенияБесед
    ГДЕ
        СообщенияБесед.Беседа В (%БеседыДляПодсчета)
        И НЕ СообщенияБесед.Служебное
        И НЕ СообщенияБесед.ПометкаУдаления
    СГРУППИРОВАТЬ ПО
        СообщенияБесед.Беседа}.Выполнить()
    для Запись из Записи
        если Запись.Беседа != Неопределено
            Результат.Вставить(Запись.Беседа!, Запись.Количество)
        ;
    ;
    возврат Результат
;

@Глобально
метод ЕстьСообщения(Беседа: Беседы.Ссылка): Булево
    исп КонтекстДоступа.Привилегированный()
    исп Записи = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1
        СообщенияБесед.Ссылка КАК Ссылка
    ИЗ
        СообщенияБесед КАК СообщенияБесед
    ГДЕ
        СообщенияБесед.Беседа == %Беседа
        И НЕ СообщенияБесед.Служебное
        И НЕ СообщенияБесед.ПометкаУдаления}.Выполнить()
    возврат не Записи.Пусто()
;

@Глобально
метод СоставМатериалов(Собеседник: Собеседники.Ссылка): МатериалыСобеседника
    исп КонтекстДоступа.Привилегированный()
    знч Сообщений = Запрос{ВЫБРАТЬ
        КОЛИЧЕСТВО(СообщенияБесед.Ссылка) КАК Количество
    ИЗ
        СообщенияБесед КАК СообщенияБесед
    ГДЕ
        СообщенияБесед.Автор == %Собеседник}.Выполнить().Единственный().Количество
    знч Файлов = Запрос{ВЫБРАТЬ
        КОЛИЧЕСТВО(Файлы.Владелец) КАК Количество
    ИЗ
        СообщенияБесед.Файлы КАК Файлы
    ГДЕ
        Файлы.Владелец.Автор == %Собеседник}.Выполнить().Единственный().Количество
    знч Реакций = Запрос{ВЫБРАТЬ
        КОЛИЧЕСТВО(Реакции.Владелец) КАК Количество
    ИЗ
        СообщенияБесед.Реакции КАК Реакции
    ГДЕ
        Реакции.Собеседник == %Собеседник
        И Реакции.Владелец.Автор != %Собеседник}.Выполнить().Единственный().Количество
    знч Бесед = Запрос{ВЫБРАТЬ
        КОЛИЧЕСТВО(УчастникиБесед.Беседа) КАК Количество
    ИЗ
        УчастникиБесед КАК УчастникиБесед
    ГДЕ
        УчастникиБесед.Собеседник == %Собеседник}.Выполнить().Единственный().Количество
    возврат новый МатериалыСобеседника(Сообщений = Сообщений, Файлов = Файлов, Реакций = Реакций, Бесед = Бесед)
;

@ВПроекте
метод ОтключенныеИзЧисла(СобеседникиДляПроверки: ЧитаемыйМассив<Собеседники.Ссылка>): Массив<Собеседники.Ссылка>
    если СобеседникиДляПроверки.Пусто()
        возврат <Собеседники.Ссылка>[]
    ;
    исп КонтекстДоступа.Привилегированный()
    возврат Запрос{
        ВЫБРАТЬ
            Собеседники.Ссылка КАК Ссылка
        ИЗ
            Собеседники КАК Собеседники
        ГДЕ
            Собеседники.Ссылка В (%СобеседникиДляПроверки)
            И Собеседники.Отключен
    }.Выполнить().Преобразовать(Стр -> Стр.Ссылка)
;

@ВПроекте
метод СобеседникЕсть(Собеседник: Собеседники.Ссылка): Булево
    исп КонтекстДоступа.Привилегированный()
    исп Записи = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1
        Собеседники.Ссылка КАК Ссылка
    ИЗ
        Собеседники КАК Собеседники
    ГДЕ
        Собеседники.Ссылка == %Собеседник}.Выполнить()
    возврат не Записи.Пусто()
;

@ВПроекте
метод БеседаЕсть(Беседа: Беседы.Ссылка): Булево
    исп КонтекстДоступа.Привилегированный()
    исп Записи = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1
        Беседы.Ссылка КАК Ссылка
    ИЗ
        Беседы КАК Беседы
    ГДЕ
        Беседы.Ссылка == %Беседа}.Выполнить()
    возврат не Записи.Пусто()
;

@Локально
метод БеседыСобеседника(Собеседник: Собеседники.Ссылка): Массив<Беседы.Ссылка>
    возврат Запрос{ВЫБРАТЬ
        УчастникиБесед.Беседа КАК Беседа
    ИЗ
        УчастникиБесед КАК УчастникиБесед
    ГДЕ
        УчастникиБесед.Собеседник == %Собеседник
        И УчастникиБесед.Состояние != СостоянияУчастникаБеседы.Администратор}.Выполнить()
        .Преобразовать(Стр -> Стр.Беседа!)
;

@Локально
метод УдалитьСообщениеСФайлами(Ссылка: СообщенияБесед.Ссылка, Файлы: Массив<ДвоичныйОбъект.Ссылка>)
    знч Сообщение = Ссылка.ЗагрузитьОбъект()
    для СтрокаФайла из Сообщение.Файлы
        если СтрокаФайла.Файл != Неопределено
            Файлы.Добавить(СтрокаФайла.Файл!)
        ;
        если СтрокаФайла.Превью != Неопределено
            Файлы.Добавить(СтрокаФайла.Превью!)
        ;
    ;
    Сообщение.Удалить()
;
